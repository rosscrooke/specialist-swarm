# Workspace API key from the Anthropic Console.
ANTHROPIC_API_KEY=sk-ant-...

# Local Godot 4.7+ binary. Optional if Godot is at /Applications/Godot.app
# or on your PATH.
GODOT_BIN=/Applications/Godot.app/Contents/MacOS/Godot

# Model overrides. Defaults to claude-opus-5 for every agent.
# Dropping the validator to a cheaper model is the usual cost lever, since
# its job is mechanical error triage.
SWARM_MODEL=claude-opus-5
SWARM_VALIDATOR_MODEL=claude-opus-5
