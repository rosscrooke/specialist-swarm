# Copy to .env (git-ignored) and fill in. Real environment variables take precedence.

# Free key from https://511.org/open-data/token — enables live Muni/BART arrivals + alerts.
FIVE11_API_KEY=

# Optional: max 511 calls per rolling hour (free tier allows ~60).
FIVE11_HOURLY_BUDGET=50

# Optional: OpenRouteService street routing, used when the public OSRM servers refuse or rate-limit.
# Free key at https://account.heigit.org/signup (2,000 routes/day).
ORS_API_KEY=

# Optional: real flight offers from Duffel (https://app.duffel.com → Developers → Access tokens).
# A duffel_test_… key returns sandbox data ("Duffel Airways"); without a key, flights use estimates.
DUFFEL_API_KEY=

# Optional: Claude agents (Intent + Explainer). Without it, rules + templates are used.
# ANTHROPIC_API_KEY=
